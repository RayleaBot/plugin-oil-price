{
  "id": "raylea.oil-price",
  "name": "油价查询",
  "version": "0.3.0",
  "manifest_version": "3",
  "license": "MIT",
  "min_core_version": "0.4.0",
  "metadata": {
    "description": "免 Key 查询各省市价区油价和城市附近大型品牌加油站",
    "author": "raylea",
    "repo": "https://github.com/RayleaBot/plugin-oil-price",
    "keywords": ["oil-price", "gas-station", "github-data", "openstreetmap"]
  },
  "concurrency": 4,
  "events": ["message.group", "message.private"],
  "permissions": {
    "message.send": true
  },
  "default_config": {
    "default_area": "北京",
    "station_limit": 5,
    "station_radius_km": 15,
    "price_cache_minutes": 60,
    "station_cache_minutes": 720
  },
  "commands": [
    {
      "id": "oil-price",
      "name": "油价",
      "description": "查询地区公开参考油价和附近大型品牌加油站",
      "usage": "/油价 [地区] [92|95|98|0] [品牌]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": ["油价"]
      }
    },
    {
      "id": "gas-stations",
      "name": "油站",
      "description": "查询地区中心附近的大型品牌加油站",
      "usage": "/油站 [地区] [品牌]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": ["油站"]
      }
    },
    {
      "id": "oil-brands",
      "name": "油品牌",
      "description": "查看支持查询的油号和加油站品牌",
      "usage": "/油品牌",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": ["油品牌"]
      }
    }
  ],
  "command_groups": [
    {
      "id": "oil-services",
      "title": "油价与加油站",
      "commands": ["oil-price", "gas-stations", "oil-brands"]
    }
  ],
  "help": {
    "title": "油价查询",
    "summary": "免 Key 查询省市价区油价和附近加油站，并可查看支持的油号与品牌"
  }
}
